node_modules/
dist/
build/
.cache/

# Local environment and credentials (safe templates may be committed)
.env*
!.env.example
!.env.*.example

# This project uses pnpm; avoid accidental npm/Yarn lockfiles
package-lock.json
yarn.lock

# Local mCare backend: database, keys and uploaded files (npm run backend)
supabase/.data/

# Vite / TypeScript caches
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo

# Test output
coverage/
.nyc_output/

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Editors and operating-system metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and temporary files
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*
/.figma/design-context/

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/
