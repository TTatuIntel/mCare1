# mCare environment template. Copy to .env.local and fill in. Never commit real values:
# .env.local is ignored by git; only this template is committed.
#
# Leave both VITE_SUPABASE_* unset for demo mode (sample data in the browser, nothing saved).
# `npm run backend` writes these two for the local backend by itself.

# ── The app (build-time, shipped to the browser: public values only) ──
# The project address ("/" = the local backend behind the dev server) and its anon (public) key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
# Push notifications: the same value as VAPID_PUBLIC_KEY below.
VITE_VAPID_PUBLIC_KEY=

# ── Local backend (npm run backend) ──
# MCARE_BACKEND_PORT=54321
# MCARE_BACKEND_HOST=127.0.0.1
# MCARE_BACKEND_URL=http://127.0.0.1:54321
# MCARE_DATA_DIR=supabase/.data
# MCARE_CONFIRM_EMAIL=1          # new accounts must enter the emailed code
# MCARE_SEED_PASSWORD=M7c24      # test accounts' password (seed script)

# ── Server side only: Edge Function secrets (`supabase secrets set …`) and scripts. Never in the browser. ──
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# MCARE_APP_URL=https://your-mcare-address
# MCARE_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# MCARE_MAIL_FROM="mCare <no-reply@your-domain>"
# MCARE_SMS_PROVIDER=africastalking   # or twilio
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@your-domain
